#!/usr/bin/env python3
"""
Nhận diện số viết tay 10–20 bằng:
tách ảnh -> chuẩn hóa từng chữ -> MLP 784-256-128-64-10.

Yêu cầu: pip install numpy pillow
CSV huấn luyện: cột đầu là nhãn 0..9, tiếp theo là 784 pixel (MNIST).
"""

import argparse
import csv
import math
from pathlib import Path

import numpy as np
from PIL import Image


INPUT_SIZE = 28 * 28
HIDDEN1 = 512
HIDDEN2 = 256
HIDDEN3 = 128
HIDDEN_SIZES = (HIDDEN1, HIDDEN2, HIDDEN3)
OUTPUT_SIZE = 10
ALPHA = 0.001
BETA1 = 0.9
BETA2 = 0.999
WEIGHT_DECAY = 1e-8
DROPOUT_RATE = 0.2
DROP_OUT_LAST_HIDDEN_LAYERS = 2
LR_DECAY = 0.9
EPOCHS = 20
BATCH_SIZE = 64
OUTPUT_DIR = Path("digit_test")


class MLP:
    def __init__(self, seed=42, hidden_sizes=HIDDEN_SIZES,
                 activation="silu", dropout_rate=DROPOUT_RATE):
        rng = np.random.default_rng(seed)
        self.rng = rng
        self.activation = activation
        self.dropout_rate = float(dropout_rate)
        if activation not in ("relu", "silu"):
            raise ValueError("activation phải là 'relu' hoặc 'silu'.")
        self.hidden_sizes = tuple(hidden_sizes)
        dimensions = [INPUT_SIZE, *self.hidden_sizes, OUTPUT_SIZE]

        # He initialization cho từng ma trận trọng số.
        self.weights = []
        self.biases = []
        for fan_in, fan_out in zip(dimensions[:-1], dimensions[1:]):
            weight = (rng.standard_normal((fan_in, fan_out)) *
                      math.sqrt(2.0 / fan_in)).astype(np.float32)
            self.weights.append(weight)
            self.biases.append(np.zeros((1, fan_out), dtype=np.float32))

        # v_* và s_* lần lượt là moment bậc nhất và bậc hai cho dW, db.
        self.v_dw = [np.zeros_like(w) for w in self.weights]
        self.s_dw = [np.zeros_like(w) for w in self.weights]
        self.v_db = [np.zeros_like(b) for b in self.biases]
        self.s_db = [np.zeros_like(b) for b in self.biases]
        self.step = 0

    @staticmethod
    def silu(x):
        clipped = np.clip(x, -60.0, 60.0)
        return x / (1.0 + np.exp(-clipped))

    @staticmethod
    def silu_derivative(x):
        sigmoid = 1.0 / (1.0 + np.exp(-np.clip(x, -60.0, 60.0)))
        return sigmoid + x * sigmoid * (1.0 - sigmoid)

    @staticmethod
    def softmax(logits):
        shifted = logits - np.max(logits, axis=1, keepdims=True)
        exps = np.exp(shifted)
        return exps / np.sum(exps, axis=1, keepdims=True)

    def forward(self, x, training=False):
        activations = [x]
        pre_activations = []
        dropout_masks = []
        hidden_count = len(self.weights) - 1
        first_dropout_layer = max(0, hidden_count - DROP_OUT_LAST_HIDDEN_LAYERS)
        for layer, (weight, bias) in enumerate(
                zip(self.weights[:-1], self.biases[:-1])):
            z = activations[-1] @ weight + bias
            pre_activations.append(z)
            if self.activation == "silu":
                activation = self.silu(z)
            else:
                activation = np.maximum(z, 0.0)

            mask = None
            if training and layer >= first_dropout_layer and self.dropout_rate > 0:
                # Inverted dropout: giữ kỳ vọng activation ổn định khi train.
                mask = (self.rng.random(activation.shape) >= self.dropout_rate)
                mask = mask.astype(np.float32) / (1.0 - self.dropout_rate)
                activation = activation * mask
            dropout_masks.append(mask)
            activations.append(activation)

        logits = activations[-1] @ self.weights[-1] + self.biases[-1]
        pre_activations.append(logits)
        return activations, pre_activations, dropout_masks, self.softmax(logits)

    def train_batch(self, x, y, learning_rate):
        n = x.shape[0]
        activations, pre_activations, dropout_masks, probs = self.forward(
            x, training=True
        )

        # Softmax + cross-entropy
        dz = probs.copy()
        dz[np.arange(n), y] -= 1.0
        dz /= n

        dW = [None] * len(self.weights)
        db = [None] * len(self.biases)
        dW[-1] = activations[-1].T @ dz
        db[-1] = np.sum(dz, axis=0, keepdims=True)

        for layer in range(len(self.weights) - 2, -1, -1):
            da = dz @ self.weights[layer + 1].T
            if dropout_masks[layer] is not None:
                da *= dropout_masks[layer]
            if self.activation == "silu":
                dz = da * self.silu_derivative(pre_activations[layer])
            else:
                dz = da * (pre_activations[layer] > 0)
            dW[layer] = activations[layer].T @ dz
            db[layer] = np.sum(dz, axis=0, keepdims=True)

        self.step += 1

        for layer in range(len(self.weights)):
            # Adam cho dW: v_dw, s_dw tương ứng với v_dw, s_dw trong slide.
            self.v_dw[layer] *= BETA1
            self.v_dw[layer] += (1.0 - BETA1) * dW[layer]
            self.s_dw[layer] *= BETA2
            self.s_dw[layer] += (1.0 - BETA2) * (dW[layer] * dW[layer])
            v_dw_corrected = self.v_dw[layer] / (1.0 - BETA1 ** self.step)
            s_dw_corrected = self.s_dw[layer] / (1.0 - BETA2 ** self.step)
            self.weights[layer] -= learning_rate * v_dw_corrected / np.sqrt(
                s_dw_corrected + 1e-8
            )
            # AdamW: decay tách rời, chỉ áp dụng cho ma trận W.
            self.weights[layer] *= (1.0 - learning_rate * WEIGHT_DECAY)

            # Adam cho db: các moment v_db, s_db của bias cũng được cập nhật.
            self.v_db[layer] *= BETA1
            self.v_db[layer] += (1.0 - BETA1) * db[layer]
            self.s_db[layer] *= BETA2
            self.s_db[layer] += (1.0 - BETA2) * (db[layer] * db[layer])
            v_db_corrected = self.v_db[layer] / (1.0 - BETA1 ** self.step)
            s_db_corrected = self.s_db[layer] / (1.0 - BETA2 ** self.step)
            self.biases[layer] -= learning_rate * v_db_corrected / np.sqrt(
                s_db_corrected + 1e-8
            )

        loss = -np.mean(np.log(np.maximum(probs[np.arange(n), y], 1e-12)))
        accuracy = np.mean(np.argmax(probs, axis=1) == y)
        return float(loss), float(accuracy)

    def predict_proba(self, x):
        return self.forward(x)[-1]

    def evaluate(self, x, y, batch_size=1024):
        total_loss = 0.0
        correct = 0
        for start in range(0, len(y), batch_size):
            xb = x[start:start + batch_size]
            yb = y[start:start + batch_size]
            probs = self.predict_proba(xb)
            chosen = probs[np.arange(len(yb)), yb]
            total_loss += -np.log(np.maximum(chosen, 1e-12)).sum()
            correct += int(np.sum(np.argmax(probs, axis=1) == yb))
        return total_loss / len(y), correct / len(y)

    def save(self, filename):
        state = {"num_layers": np.array(len(self.weights)),
                 "hidden_sizes": np.array(self.hidden_sizes, dtype=np.int64),
                 "activation": np.array(self.activation),
                 "dropout_rate": np.array(self.dropout_rate)}
        for i, (weight, bias) in enumerate(zip(self.weights, self.biases), 1):
            state[f"W{i}"] = weight
            state[f"b{i}"] = bias
        np.savez(filename, **state)

    @classmethod
    def load(cls, filename):
        data = np.load(filename)
        num_layers = int(data["num_layers"]) if "num_layers" in data else 3
        weights = [data[f"W{i}"].astype(np.float32)
                   for i in range(1, num_layers + 1)]
        biases = [data[f"b{i}"].astype(np.float32)
                  for i in range(1, num_layers + 1)]
        hidden_sizes = tuple(w.shape[1] for w in weights[:-1])
        activation = str(data["activation"].item()) if "activation" in data else "relu"
        dropout_rate = float(data["dropout_rate"]) if "dropout_rate" in data else 0.0
        model = cls(hidden_sizes=hidden_sizes, activation=activation,
                    dropout_rate=dropout_rate)
        model.weights, model.biases = weights, biases
        model.v_dw = [np.zeros_like(w) for w in weights]
        model.s_dw = [np.zeros_like(w) for w in weights]
        model.v_db = [np.zeros_like(b) for b in biases]
        model.s_db = [np.zeros_like(b) for b in biases]
        return model


def load_mnist_csv(filename):
    """Đọc CSV: label,pixel0,...,pixel783; nhãn phải là 0..9."""
    print(f"Đang đọc {filename} ...")
    rows = []
    malformed = 0
    with open(filename, "r", newline="", encoding="utf-8-sig") as file:
        reader = csv.reader(file)
        next(reader, None)  # bỏ dòng tiêu đề
        for row in reader:
            if len(row) != INPUT_SIZE + 1:
                malformed += 1
                continue
            try:
                rows.append([float(value) for value in row])
            except ValueError:
                malformed += 1
    if not rows:
        raise ValueError("CSV không có dòng dữ liệu hợp lệ (cần 785 cột mỗi dòng).")
    if malformed:
        print(f"Bỏ qua {malformed} dòng lỗi/không đủ 785 cột trong CSV.")
    data = np.asarray(rows, dtype=np.float32)
    if data.ndim != 2 or data.shape[1] != INPUT_SIZE + 1:
        raise ValueError(
            f"CSV cần có 785 cột (label + 784 pixel), đang có "
            f"{data.shape[1] if data.ndim == 2 else 'định dạng không hợp lệ'}."
        )

    labels = data[:, 0].astype(np.int64)
    if np.any((labels < 0) | (labels > 9)):
        raise ValueError("CSV huấn luyện chữ số đơn phải có nhãn từ 0 đến 9.")

    images = data[:, 1:] / 255.0
    return images.astype(np.float32), labels


def augment_mnist_batch(images, rng):
    """Xoay nhẹ và dịch ảnh MNIST vài pixel, không thay đổi nhãn."""
    augmented = np.empty_like(images, dtype=np.float32)
    for index, flat_image in enumerate(images):
        image = np.clip(flat_image.reshape(28, 28) * 255.0, 0, 255).astype(np.uint8)
        pil_image = Image.fromarray(image, mode="L")
        transformed = pil_image.rotate(
            float(rng.uniform(-8.0, 8.0)),
            resample=Image.Resampling.BILINEAR,
            translate=(int(rng.integers(-2, 3)), int(rng.integers(-2, 3))),
            fillcolor=0,
        )
        augmented[index] = np.asarray(transformed, dtype=np.float32).reshape(-1) / 255.0
    return augmented


def train(csv_path, model_path=None, plot_path=None, history_path=None,
          hidden_sizes=HIDDEN_SIZES, dropout_rate=DROPOUT_RATE):
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    model_path = model_path or str(OUTPUT_DIR / "digit_mlp.npz")
    plot_path = plot_path or str(OUTPUT_DIR / "training_curves.png")
    history_path = history_path or str(OUTPUT_DIR / "training_history.npz")
    x, y = load_mnist_csv(csv_path)

    rng = np.random.default_rng(42)
    order = rng.permutation(len(y))
    val_count = max(1, int(0.1 * len(y)))
    val_ids, train_ids = order[:val_count], order[val_count:]
    x_val, y_val = x[val_ids], y[val_ids]
    x_train, y_train = x[train_ids], y[train_ids]

    model = MLP(seed=42, hidden_sizes=hidden_sizes, dropout_rate=dropout_rate)
    history = {"train_loss": [], "val_loss": [],
               "train_accuracy": [], "val_accuracy": [], "learning_rate": []}
    best_val_accuracy = -1.0
    best_weights, best_biases = None, None
    # Đo train metrics trên một tập con cố định để biểu đồ nhanh và so sánh được.
    metric_count = min(5000, len(x_train))
    x_train_metric, y_train_metric = x_train[:metric_count], y_train[:metric_count]

    for epoch in range(EPOCHS):
        current_lr = ALPHA * (LR_DECAY ** epoch)
        perm = rng.permutation(len(y_train))

        for start in range(0, len(perm), BATCH_SIZE):
            ids = perm[start:start + BATCH_SIZE]
            batch_x = augment_mnist_batch(x_train[ids], rng)
            model.train_batch(batch_x, y_train[ids], current_lr)

        train_loss, train_accuracy = model.evaluate(x_train_metric, y_train_metric)
        val_loss, val_accuracy = model.evaluate(x_val, y_val)
        history["train_loss"].append(train_loss)
        history["val_loss"].append(val_loss)
        history["train_accuracy"].append(train_accuracy)
        history["val_accuracy"].append(val_accuracy)
        history["learning_rate"].append(current_lr)
        if val_accuracy > best_val_accuracy:
            best_val_accuracy = val_accuracy
            best_weights = [weight.copy() for weight in model.weights]
            best_biases = [bias.copy() for bias in model.biases]
            best_epoch = epoch + 1
        print(
            f"Epoch {epoch + 1}/{EPOCHS} | "
            f"train loss={train_loss:.4f} | val loss={val_loss:.4f} | "
            f"train acc={train_accuracy:.4f} | val acc={val_accuracy:.4f} | "
            f"lr={current_lr:.6f}"
        )

    # Lưu checkpoint từ epoch validation tốt nhất, không mặc định lấy epoch cuối.
    model.weights, model.biases = best_weights, best_biases
    model.save(model_path)
    print(f"Đã lưu mô hình (epoch tốt nhất {best_epoch}, "
          f"val acc={best_val_accuracy:.4%}): {model_path}")
    np.savez(history_path, **history,
             hidden_sizes=np.asarray(hidden_sizes, dtype=np.int64),
             dropout_rate=dropout_rate)
    print(f"Đã lưu lịch sử huấn luyện: {history_path}")
    plot_training_history(history, plot_path, hidden_sizes, dropout_rate)


def plot_training_history(history, plot_path, hidden_sizes,
                          dropout_rate=DROPOUT_RATE):
    import matplotlib.pyplot as plt

    epochs = np.arange(1, len(history["train_loss"]) + 1)
    fig, axes = plt.subplots(1, 3, figsize=(15, 4))

    axes[0].plot(epochs, history["train_loss"], marker="o", label="Train loss")
    axes[0].plot(epochs, history["val_loss"], marker="o", label="Validation loss")
    axes[0].set_title("Loss theo epoch")
    axes[0].set_xlabel("Epoch")
    axes[0].set_ylabel("Cross-entropy loss")
    axes[0].grid(True, alpha=0.3)
    axes[0].legend()

    axes[1].plot(epochs, history["train_accuracy"], marker="o", label="Train accuracy")
    axes[1].plot(epochs, history["val_accuracy"], marker="o", label="Validation accuracy")
    axes[1].set_title("Accuracy theo epoch")
    axes[1].set_xlabel("Epoch")
    axes[1].set_ylabel("Accuracy")
    axes[1].set_ylim(0, 1.02)
    axes[1].grid(True, alpha=0.3)
    axes[1].legend()

    if "learning_rate" in history:
        axes[2].plot(epochs, history["learning_rate"], marker="o", color="green")
        axes[2].set_title("Learning rate decay")
        axes[2].set_xlabel("Epoch")
        axes[2].set_ylabel("Learning rate")
        axes[2].grid(True, alpha=0.3)
    else:
        axes[2].axis("off")

    architecture = " → ".join(map(str, (INPUT_SIZE, *hidden_sizes, OUTPUT_SIZE)))
    fig.suptitle(
        f"MLP {architecture} | "
        f"SiLU, dropout={dropout_rate} (2 lớp cuối), augmentation ±8°/2px | "
        f"α₀={ALPHA}, β₁={BETA1}, β₂={BETA2}, weight decay={WEIGHT_DECAY}"
    )
    fig.tight_layout()
    fig.savefig(plot_path, dpi=160, bbox_inches="tight")
    print(f"Đã lưu biểu đồ huấn luyện: {plot_path}")
    plt.show()


def show_saved_history(history_path="training_history.npz",
                       plot_path="training_curves.png"):
    data = np.load(history_path)
    keys = ["train_loss", "val_loss", "train_accuracy", "val_accuracy"]
    if "learning_rate" in data:
        keys.append("learning_rate")
    history = {key: data[key] for key in keys}
    if "hidden_sizes" in data:
        hidden_sizes = tuple(int(value) for value in data["hidden_sizes"])
    else:
        hidden_sizes = (int(data["hidden1"]), int(data["hidden2"]))
    dropout_rate = float(data["dropout_rate"]) if "dropout_rate" in data else DROPOUT_RATE
    plot_training_history(history, plot_path, hidden_sizes, dropout_rate)


