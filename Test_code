def otsu_threshold(gray):
    """Tính ngưỡng Otsu, không cần OpenCV."""
    hist = np.bincount(gray.ravel(), minlength=256).astype(np.float64)
    total = gray.size
    sum_total = np.dot(np.arange(256), hist)
    weight_bg = 0.0
    sum_bg = 0.0
    best_var = -1.0
    best_t = 127

    for t in range(256):
        weight_bg += hist[t]
        if weight_bg == 0:
            continue
        weight_fg = total - weight_bg
        if weight_fg == 0:
            break
        sum_bg += t * hist[t]
        mean_bg = sum_bg / weight_bg
        mean_fg = (sum_total - sum_bg) / weight_fg
        between_var = weight_bg * weight_fg * (mean_bg - mean_fg) ** 2
        if between_var > best_var:
            best_var, best_t = between_var, t

    return best_t


def gray_to_ink_mask(gray):
    gray = np.asarray(gray, dtype=np.uint8)
    if gray.shape != (28, 28):
        raise ValueError(f"Ảnh cần có kích thước 28x28, nhận được {gray.shape}.")

    threshold = otsu_threshold(gray)
    # Tự xác định màu nền dựa trên viền ảnh.
    border = np.concatenate((gray[0, :], gray[-1, :], gray[:, 0], gray[:, -1]))
    if np.median(border) > 127:   # nền sáng, nét tối
        ink = gray <= threshold
    else:                         # nền tối, nét sáng (kiểu MNIST)
        ink = gray > threshold

    # Lọc các pixel đơn lẻ nhiễu: chỉ giữ pixel có láng giềng nét.
    padded = np.pad(ink, 1, mode="constant")
    neighbors = np.zeros_like(ink, dtype=np.uint8)
    for dy in range(3):
        for dx in range(3):
            neighbors += padded[dy:dy + 28, dx:dx + 28]
    ink &= neighbors >= 2
    return (ink.astype(np.uint8) * 255)


def get_ink_mask(image_path):
    gray = np.asarray(Image.open(image_path).convert("L"), dtype=np.uint8)
    return gray_to_ink_mask(gray)


def split_two_digits(ink):
    """Tách ở cột có ít nét nhất trong vùng quanh giữa ảnh."""
    if not np.any(ink):
        raise ValueError("Ảnh không có nét sau khi nhị phân hóa.")
    projection = np.count_nonzero(ink, axis=0)
    lo, hi = max(1, int(28 * 0.30)), min(26, int(28 * 0.70))
    total_ink = int(projection.sum())
    # Loại điểm cắt khiến gần như toàn bộ nét rơi vào cùng một phía.
    minimum_side_ink = max(1, int(total_ink * 0.12))
    candidates = [
        c for c in range(lo, hi + 1)
        if projection[:c].sum() >= minimum_side_ink
        and projection[c:].sum() >= minimum_side_ink
    ]
    if not candidates:
        raise ValueError("Không tìm được điểm cắt chia nét thành hai vùng.")
    center = 13.5
    cut = min(candidates, key=lambda c: (projection[c], abs(c - center)))

    left = ink[:, :cut]
    right = ink[:, cut:]
    if not np.any(left) or not np.any(right):
        raise ValueError("Không tách được hai chữ số; hãy kiểm tra ảnh đầu vào.")
    return left, right, int(cut)


def normalize_digit(crop):
    """Cắt khung nét, giữ tỷ lệ, đặt vào 28x28 và căn trọng tâm."""
    ys, xs = np.nonzero(crop)
    if len(xs) == 0:
        raise ValueError("Một vùng chữ số bị rỗng.")

    crop = crop[ys.min():ys.max() + 1, xs.min():xs.max() + 1]
    h, w = crop.shape
    scale = 20.0 / max(h, w)
    new_w = max(1, int(round(w * scale)))
    new_h = max(1, int(round(h * scale)))

    small = Image.fromarray(crop).resize((new_w, new_h), Image.Resampling.LANCZOS)
    canvas = Image.new("L", (28, 28), 0)
    canvas.paste(small, ((28 - new_w) // 2, (28 - new_h) // 2))
    arr = np.asarray(canvas, dtype=np.uint8)

    # Dịch trọng tâm về giữa ảnh, tương tự căn chỉnh kiểu MNIST.
    mass = arr.astype(np.float64)
    total = mass.sum()
    if total > 0:
        yy, xx = np.indices(arr.shape)
        cx = (xx * mass).sum() / total
        cy = (yy * mass).sum() / total
        dx, dy = int(round(13.5 - cx)), int(round(13.5 - cy))
        shifted = np.zeros_like(arr)
        x0, y0 = max(0, dx), max(0, dy)
        sx0, sy0 = max(0, -dx), max(0, -dy)
        copy_w = min(28 - x0, 28 - sx0)
        copy_h = min(28 - y0, 28 - sy0)
        if copy_w > 0 and copy_h > 0:
            shifted[y0:y0 + copy_h, x0:x0 + copy_w] = \
                arr[sy0:sy0 + copy_h, sx0:sx0 + copy_w]
        arr = shifted

    return arr.astype(np.float32).reshape(1, INPUT_SIZE) / 255.0


def predict_from_gray(model, gray):
    ink = gray_to_ink_mask(gray)
    left, right, cut = split_two_digits(ink)

    digit_probabilities = []
    for crop in (left, right):
        x = normalize_digit(crop)
        probs = model.predict_proba(x)[0]
        digit_probabilities.append(probs)

    # Chỉ xét các cặp chữ số tạo thành class hợp lệ từ 10 đến 20.
    p_tens, p_units = digit_probabilities
    candidates = [(10 + unit, float(p_tens[1] * p_units[unit]))
                  for unit in range(10)]
    candidates.append((20, float(p_tens[2] * p_units[0])))
    number, _ = max(candidates, key=lambda item: item[1])
    digits = [number // 10, number % 10]
    confidences = [float(p_tens[digits[0]]), float(p_units[digits[1]])]
    return number, digits, confidences, cut


def predict(model_path, image_path):
    model = MLP.load(model_path)
    gray = np.asarray(Image.open(image_path).convert("L"), dtype=np.uint8)
    if gray.shape != (28, 28):
        raise ValueError(f"Ảnh cần có kích thước 28x28, nhận được {gray.shape}.")
    number, digits, confidences, cut = predict_from_gray(model, gray)
    print(f"Vị trí cắt: cột {cut}")
    print(f"Dự đoán chữ số: {digits[0]} (xác suất {confidences[0]:.3f})")
    print(f"Dự đoán chữ số: {digits[1]} (xác suất {confidences[1]:.3f})")
    print(f"Số dự đoán: {number}")
    if not 10 <= number <= 20:
        print("Cảnh báo: kết quả nằm ngoài khoảng 10–20.")
    return number


def load_number_csv(filename, has_labels):
    """Đọc ảnh số 28x28: 784 pixel, có thể có thêm cột nhãn đầu tiên."""
    data = np.loadtxt(filename, delimiter=",", skiprows=1, dtype=np.float32)
    if data.ndim == 1:
        data = data.reshape(1, -1)
    expected_cols = INPUT_SIZE + int(has_labels)
    if data.ndim != 2 or data.shape[1] != expected_cols:
        raise ValueError(
            f"CSV {'có nhãn' if has_labels else 'không nhãn'} cần {expected_cols} cột, "
            f"nhưng file có {data.shape[1] if data.ndim == 2 else 'định dạng sai'} cột."
        )
    if has_labels:
        labels = data[:, 0].astype(np.int64)
        pixels = data[:, 1:]
        if np.any((labels < 10) | (labels > 20)):
            raise ValueError("Nhãn trong test CSV phải nằm trong khoảng 10–20.")
        return pixels, labels
    return data, None


def load_kaggle_test_csv(filename):
    """Đọc Kaggle test.csv theo dạng id,pixel0,...,pixel783."""
    ids, rows = [], []
    expected_header = ["id"] + [f"pixel{i}" for i in range(INPUT_SIZE)]
    with open(filename, "r", newline="", encoding="utf-8-sig") as file:
        reader = csv.reader(file)
        header = next(reader, None)
        if header is None or [name.strip() for name in header] != expected_header:
            raise ValueError(
                "test.csv cần header id,pixel0,...,pixel783 theo đúng thứ tự."
            )
        for line_number, row in enumerate(reader, start=2):
            if not row:
                continue
            if len(row) != INPUT_SIZE + 1:
                raise ValueError(
                    f"Dòng {line_number} có {len(row)} cột; cần 785 cột (id + 784 pixel)."
                )
            sample_id = row[0].strip()
            if not sample_id:
                raise ValueError(f"Dòng {line_number} thiếu id.")
            try:
                pixels = [float(value) for value in row[1:]]
            except ValueError as error:
                raise ValueError(f"Pixel không hợp lệ ở dòng {line_number}.") from error
            if not np.all(np.isfinite(pixels)):
                raise ValueError(f"Pixel không hữu hạn ở dòng {line_number}.")
            ids.append(sample_id)
            rows.append(pixels)

    if not rows:
        raise ValueError("test.csv không chứa ảnh nào.")
    if len(set(ids)) != len(ids):
        raise ValueError("Cột id trong test.csv có giá trị trùng lặp.")
    return ids, np.asarray(rows, dtype=np.float32)


def test_csv(model_path, csv_path):
    """Đánh giá trên CSV: label 10..20, sau đó là 784 pixel của ảnh 28x28."""
    model = MLP.load(model_path)
    pixels, labels = load_number_csv(csv_path, has_labels=True)
    predictions = []
    failures = 0
    for index, row in enumerate(pixels):
        gray = np.clip(row.reshape(28, 28), 0, 255).astype(np.uint8)
        try:
            prediction, _, _, _ = predict_from_gray(model, gray)
            predictions.append(prediction)
        except ValueError as error:
            failures += 1
            predictions.append(-1)  # tính là sai, nhưng tiếp tục các ảnh sau
            if failures <= 5:
                print(f"Ảnh dòng {index + 2}: không tách được ({error})")

    predictions = np.asarray(predictions)
    accuracy = np.mean(predictions == labels)
    print(f"Số ảnh test: {len(labels)}")
    print(f"Ảnh không tách được: {failures}")
    print(f"Accuracy toàn số: {accuracy:.4%}")
    print("Một số kết quả (nhãn thật -> dự đoán):")
    for true_label, predicted in list(zip(labels, predictions))[:10]:
        print(f"  {true_label:2d} -> {predicted:2d}")


def load_id_labels_csv(filename, description):
    """Đọc CSV có đúng hai cột id,label; trả về ánh xạ id -> nhãn."""
    labels_by_id = {}
    with open(filename, "r", newline="", encoding="utf-8-sig") as file:
        reader = csv.DictReader(file)
        if reader.fieldnames is None or [name.strip() for name in reader.fieldnames] != ["id", "label"]:
            raise ValueError(f"{description} cần header đúng dạng id,label.")
        for line_number, row in enumerate(reader, start=2):
            sample_id = (row.get("id") or "").strip()
            raw_label = (row.get("label") or "").strip()
            if not sample_id:
                raise ValueError(f"{description}: dòng {line_number} thiếu id.")
            if sample_id in labels_by_id:
                raise ValueError(f"{description}: id={sample_id} bị trùng.")
            try:
                label = int(raw_label)
            except ValueError as error:
                raise ValueError(
                    f"{description}: nhãn không hợp lệ ở dòng {line_number}."
                ) from error
            if not 10 <= label <= 20:
                raise ValueError(
                    f"{description}: nhãn id={sample_id} phải nằm trong khoảng 10–20."
                )
            labels_by_id[sample_id] = label
    if not labels_by_id:
        raise ValueError(f"{description} không có dữ liệu.")
    return labels_by_id


def compare_accuracy(submission_path, labels_path):
    """So sánh file submission id,label với file nhãn tham khảo theo id."""
    predictions = load_id_labels_csv(submission_path, "File submission")
    references = load_id_labels_csv(labels_path, "File nhãn tham khảo")
    missing_labels = sorted(set(predictions) - set(references))
    missing_predictions = sorted(set(references) - set(predictions))
    if missing_labels or missing_predictions:
        details = []
        if missing_labels:
            details.append(
                f"thiếu nhãn cho {len(missing_labels)} id trong submission "
                f"(ví dụ: {', '.join(missing_labels[:5])})"
            )
        if missing_predictions:
            details.append(
                f"file nhãn có {len(missing_predictions)} id không có trong submission "
                f"(ví dụ: {', '.join(missing_predictions[:5])})"
            )
        raise ValueError("Hai file không khớp danh sách id: " + "; ".join(details))

    total = len(predictions)
    correct = sum(predictions[sample_id] == references[sample_id] for sample_id in predictions)
    accuracy = correct / total
    print(f"Số mẫu đối chiếu: {total}")
    print(f"Dự đoán trùng nhãn tham khảo: {correct}/{total}")
    print(f"Accuracy đối chiếu với nhãn tham khảo: {accuracy:.4%}")
    print("Lưu ý: đây là mức khớp với file nhãn tham khảo, không phải accuracy Kaggle chính thức.")
    return accuracy


def predict_csv(model_path, csv_path, output_path, labels_path=None):
    """Dự đoán Kaggle test.csv; có thể đối chiếu ngay với file nhãn tham khảo."""
    model = MLP.load(model_path)
    ids, pixels = load_kaggle_test_csv(csv_path)
    predictions = []
    for index, row in enumerate(pixels):
        gray = np.clip(row.reshape(28, 28), 0, 255).astype(np.uint8)
        try:
            prediction, _, _, _ = predict_from_gray(model, gray)
        except ValueError as error:
            raise ValueError(
                f"Không xử lý được ảnh id={ids[index]} (dòng {index + 2}): {error}"
            ) from error
        predictions.append(prediction)

    with open(output_path, "w", newline="", encoding="utf-8") as file:
        writer = csv.writer(file)
        writer.writerow(["id", "label"])
        writer.writerows(zip(ids, predictions))
    print(f"Đã dự đoán {len(predictions)} ảnh. File Kaggle: {output_path}")
    if labels_path:
        compare_accuracy(output_path, labels_path)


def visualize_csv_row(model_path, csv_path, row_index):
    """Vẽ ảnh gốc, điểm cắt, hai chữ đã chuẩn hóa và dự đoán."""
    import matplotlib.pyplot as plt

    model = MLP.load(model_path)
    pixels, labels = load_number_csv(csv_path, has_labels=True)
    if row_index < 0 or row_index >= len(pixels):
        raise IndexError(f"row phải nằm trong khoảng 0 đến {len(pixels) - 1}.")

    gray = np.clip(pixels[row_index].reshape(28, 28), 0, 255).astype(np.uint8)
    mask = gray_to_ink_mask(gray)
    left, right, cut = split_two_digits(mask)
    left_norm = normalize_digit(left).reshape(28, 28)
    right_norm = normalize_digit(right).reshape(28, 28)

    predicted, digits, confidence, _ = predict_from_gray(model, gray)
    true_label = int(labels[row_index])

    fig, axes = plt.subplots(1, 4, figsize=(11, 3))
    axes[0].imshow(gray, cmap="gray", vmin=0, vmax=255)
    axes[0].set_title(f"Ảnh gốc — nhãn {true_label}")

    axes[1].imshow(mask, cmap="gray", vmin=0, vmax=255)
    axes[1].axvline(cut - 0.5, color="red", linewidth=1.5)
    axes[1].set_title(f"Nhị phân + cắt tại cột {cut}")

    axes[2].imshow(left_norm, cmap="gray", vmin=0, vmax=1)
    axes[2].set_title(f"Chữ 1 → {digits[0]} ({confidence[0]:.2f})")

    axes[3].imshow(right_norm, cmap="gray", vmin=0, vmax=1)
    axes[3].set_title(f"Chữ 2 → {digits[1]} ({confidence[1]:.2f})")

    for ax in axes:
        ax.axis("off")
    fig.suptitle(f"Dự đoán: {predicted} | Nhãn thật: {true_label}")
    plt.tight_layout()
    plt.show()


def main():
    parser = argparse.ArgumentParser(
        description="Nhận diện số viết tay 10–20 bằng MLP."
    )
    subparsers = parser.add_subparsers(dest="mode")

    p_train = subparsers.add_parser("train", help="Huấn luyện MLP từ MNIST CSV")
    p_train.add_argument("csv", help="CSV có nhãn 0–9 và 784 pixel")
    # Cấu hình train cố định; chỉ cần truyền đường dẫn CSV.

    p_predict = subparsers.add_parser("predict", help="Dự đoán ảnh hai chữ số")
    p_predict.add_argument("image", help="Ảnh xám 28x28 chứa một số 10–20")
    p_predict.add_argument("--model", default=str(OUTPUT_DIR / "digit_mlp.npz"))

    p_test = subparsers.add_parser("test", help="Đánh giá CSV có nhãn 10–20")
    p_test.add_argument("csv", help="CSV: label (10–20) + 784 pixel")
    p_test.add_argument("--model", default=str(OUTPUT_DIR / "digit_mlp.npz"))

    p_predict_csv = subparsers.add_parser(
        "predict-csv", help="Tạo submission Kaggle từ test.csv có id và 784 pixel"
    )
    p_predict_csv.add_argument("csv", help="test.csv: id,pixel0,...,pixel783")
    p_predict_csv.add_argument("--model", default=str(OUTPUT_DIR / "digit_mlp.npz"))
    p_predict_csv.add_argument("--output", default="submission.csv")
    p_predict_csv.add_argument(
        "--labels", help="CSV nhãn tham khảo id,label để in accuracy đối chiếu"
    )

    p_compare = subparsers.add_parser(
        "compare-accuracy", help="So sánh submission.csv với CSV nhãn id,label"
    )
    p_compare.add_argument("submission", help="CSV dự đoán gồm id,label")
    p_compare.add_argument("labels", help="CSV nhãn tham khảo gồm id,label")

    p_plot = subparsers.add_parser("plot-history", help="Mở biểu đồ loss/accuracy đã lưu")
    p_plot.add_argument("--history", default=str(OUTPUT_DIR / "training_history.npz"))
    p_plot.add_argument("--plot", default=str(OUTPUT_DIR / "training_curves.png"))

    args = parser.parse_args()
    if args.mode is None:
        interactive_menu()
        return
    if args.mode == "train":
        train(args.csv)
    elif args.mode == "predict":
        predict(args.model, args.image)
    elif args.mode == "test":
        test_csv(args.model, args.csv)
    elif args.mode == "predict-csv":
        predict_csv(args.model, args.csv, args.output, labels_path=args.labels)
    elif args.mode == "compare-accuracy":
        compare_accuracy(args.submission, args.labels)
    elif args.mode == "plot-history":
        show_saved_history(args.history, args.plot)
    else:
        parser.error("Chế độ không hợp lệ")


if __name__ == "__main__":
    main()
